{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuestionBank",
  "description": "Schema consolidado para datasets db-*.json (preguntas, topics y subtopics).",
  "type": "object",
  "additionalProperties": true,
  "required": ["topics", "questions"],
  "properties": {
    "topics": {
      "type": "array",
      "items": { "$ref": "#/definitions/topic" }
    },
    "questions": {
      "type": "array",
      "items": { "$ref": "#/definitions/question" }
    },
    "flashcards": {
      "description": "Flashcards curadas para repaso (independientes de las preguntas de test). Si un dataset declara este array, en runtime se usa para mostrar flashcards en lugar de derivarlas automáticamente de las preguntas. Pensadas para opositor/a: el enunciado debe tener sentido sin opciones visibles, y la respuesta debe ser concreta y memorizable.",
      "type": "array",
      "items": { "$ref": "#/definitions/flashcard" }
    },
    "comments": {
      "description": "Campo legacy, no usado en la aplicación.",
      "type": "array"
    },
    "statistics": {
      "description": "Campo legacy, no usado en la aplicación.",
      "type": "object"
    },
    "studySessions": {
      "description": "Campo legacy, no usado en la aplicación.",
      "type": "array"
    }
  },
  "definitions": {
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "order", "subtopics"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "order": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "subtopics": {
          "type": "array",
          "items": { "$ref": "#/definitions/subtopic" }
        }
      }
    },
    "subtopic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "topicId", "title", "order"],
      "properties": {
        "id": { "type": "string" },
        "topicId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "order": { "type": "integer" },
        "syllabusCoverageIds": {
          "description": "IDs de cobertura de convocatoria (para filtrar qué entra en cada temario).",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "topicId", "question", "options"],
      "anyOf": [
        { "required": ["correctAnswer"] },
        { "required": ["correctIndex"] }
      ],
      "properties": {
        "id": { "type": "string" },
        "topicId": { "type": "string" },
        "question": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2
        },
        "correctAnswer": {
          "description": "Índice (base 0) de la opción correcta.",
          "type": "integer",
          "minimum": 0
        },
        "correctIndex": {
          "description": "Alias de correctAnswer para compatibilidad.",
          "type": "integer",
          "minimum": 0
        },
        "explanation": { "type": "string" },
        "difficulty": {
          "type": "string",
          "enum": ["basica", "intermedia", "avanzada"]
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "source": { "$ref": "#/definitions/source" },
        "origin": {
          "description": "Origen editorial/validación del contenido: 'oficial' para preguntas oficiales directas, 'adaptada-ia' para preguntas existentes/oficiales adaptadas con IA, 'generada-ia' para preguntas completamente generadas, o una fuente externa explícita como 'oposito.es', 'leyesdeoposiciones.es', 'quizlet.com' u 'opositatest.com'.",
          "type": "string"
        },
        "duplicateOf": {
          "description": "ID de la pregunta canónica de la que esta es duplicado. Las preguntas duplicadas deben marcarse (no eliminarse) para trazabilidad y análisis posterior.",
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materialId", "path", "highlightText"],
      "properties": {
        "materialId": { "type": "string" },
        "path": { "type": "string" },
        "highlightText": { "type": "string" }
      }
    },
    "flashcard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "topicId", "question", "answer"],
      "properties": {
        "id": { "type": "string" },
        "topicId": { "type": "string" },
        "question": {
          "description": "Enunciado/cara frontal de la flashcard. Debe tener sentido sin ver opciones (no usar 'cuál de las siguientes' u otras formulaciones de test).",
          "type": "string"
        },
        "answer": {
          "description": "Respuesta/cara reverso. Concreta, memorizable y revisable de un vistazo.",
          "type": "string"
        },
        "origin": {
          "description": "Origen editorial/validación del contenido (ver 'origin' de las preguntas).",
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "difficulty": {
          "type": "string",
          "enum": ["basica", "intermedia", "avanzada"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "source": { "$ref": "#/definitions/source" }
      }
    }
  }
}
